# Copy file ini menjadi .env, lalu isi API key jika ingin bot memakai OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opsional
HOST=127.0.0.1
PORT=8765
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
BOT_INSTRUCTIONS=Anda adalah asisten lokal berbahasa Indonesia untuk eksperimen bot, data, dan machine learning XAU/USD.

# Binance: mulai dari testnet dulu. Untuk API key official RSA, pakai BINANCE_MODE=live dan BINANCE_KEY_TYPE=rsa.
BINANCE_MODE=live
BINANCE_KEY_TYPE=rsa
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=private_key.pem
TRADE_SYMBOL=BTCUSDT
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
