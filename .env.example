# Copy file ini menjadi .env, lalu isi API key jika ingin bot memakai OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opsional
HOST=127.0.0.1
PORT=8765
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
BOT_INSTRUCTIONS=Anda adalah asisten lokal berbahasa Indonesia untuk eksperimen bot, data, dan machine learning XAU/USD.

# Binance: mulai dari testnet dulu. Untuk API key official RSA, pakai BINANCE_MODE=live dan BINANCE_KEY_TYPE=rsa.
BINANCE_MODE=live
BINANCE_KEY_TYPE=rsa
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=private_key.pem
TRADE_SYMBOL=BTCUSDT
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03

# === Auto trading TradingView -> Binance Futures ===
# AMAN: default false/true agar tidak langsung order real.
# AUTO_TRADE_ENABLED bisa diubah dari dashboard untuk pause/resume entry baru.
BINANCE_MARKET_TYPE=futures
AUTO_TRADE_ENABLED=false
DRY_RUN=true
WEBHOOK_TOKEN=ganti-token-rahasia
ACCOUNT_BALANCE_IDR=37453.63
USDT_IDR_RATE=17578.41
ACCOUNT_BALANCE_USDT=2.13
MAX_ORDER_BALANCE_PERCENT=8
DEFAULT_LEVERAGE=1
ORDER_USDT=0.17
MAX_OPEN_POSITIONS=1
ENTRY_ORDER_TYPE=LIMIT
ENTRY_LIMIT_OFFSET_PERCENT=0.03
ENTRY_LIMIT_TIME_IN_FORCE=GTC
CANCEL_STALE_LIMIT_ORDERS=false
LIMIT_ORDER_MAX_AGE_SECONDS=180

# === Auto scalping multi-pair ===
AUTO_SCALPING=true
SCALPING_INTERVAL=180
POSITION_MONITOR_INTERVAL_SECONDS=3
SCALPING_TIMEFRAME=5m
TREND_TIMEFRAME=15m
SCALPING_SYMBOLS=AUTO
AUTO_SYMBOL_MODE=gainers
AUTO_SYMBOL_LIMIT=3
AUTO_SYMBOL_MIN_QUOTE_VOLUME=20000000
AUTO_SYMBOL_REFRESH_SECONDS=300
AUTO_SYMBOL_BLACKLIST=USDCUSDT,FDUSDUSDT
SIGNAL_CACHE_TTL_SECONDS=60

# Entry hanya untuk sinyal kuat.
SIGNAL_STRATEGY_MODE=score
SIGNAL_SCORE_THRESHOLD=8
REQUIRE_SCORE_TRIGGER=true
SIGNAL_SCORE_MIN_EDGE=3
ENTRY_COOLDOWN_SECONDS=1800
MAX_DAILY_TRADES=1

# Adaptasi LuxAlgo Price Action Concepts untuk score bot:
# internal/swing BOS/CHoCH, Fair Value Gap, dan reversal bands.
ENABLE_PRICE_ACTION_CONCEPTS=true
PAC_INTERNAL_LOOKBACK=5
PAC_SWING_LOOKBACK=50
PAC_INTERNAL_STRUCTURE_WEIGHT=2
PAC_SWING_STRUCTURE_WEIGHT=3
PAC_FVG_WEIGHT=1
PAC_FVG_MAX_WIDTH_PERCENT=2
PAC_FVG_MAX_ACTIVE=8
PAC_FVG_MITIGATION=Close
PAC_REVERSAL_BANDS_LENGTH=30
PAC_REVERSAL_BAND_WEIGHT=1
PAC_PROFILE_LOOKBACK=200
PAC_PROFILE_ROWS=25
PAC_PROFILE_WEIGHT=1
PAC_PROFILE_POC_DISTANCE_PERCENT=0.35
PAC_PREMIUM_DISCOUNT_WEIGHT=1
PAC_DISCOUNT_LEVEL=0.35
PAC_PREMIUM_LEVEL=0.65
PAC_ORDER_BLOCK_WEIGHT=2
PAC_ORDER_BLOCK_TOUCH_ATR=0.35
PAC_STRONG_WEAK_WEIGHT=1

EMA_FAST=9
EMA_SLOW=21
TREND_EMA_FAST=21
TREND_EMA_SLOW=55
BUY_RSI=55
SELL_RSI=45
USE_RSI_REGIME_FILTER=true
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
RSI_LONG_BLOCK_ABOVE=72
RSI_SHORT_BLOCK_BELOW=28
RSI_REVERSAL_LONG_BELOW=35
RSI_REVERSAL_SHORT_ABOVE=65
RSI_REGIME_WEIGHT=1
TREND_BUY_RSI=52
TREND_SELL_RSI=48
VOLUME_MULTIPLIER=1.2
FAST_SIGNAL_MODE=false
ATR_PERIOD=14
ATR_MIN_MULTIPLIER=0.75
ATR_MAX_MULTIPLIER=1.8
DISABLE_COUNTER_TREND=true
USE_ORDER_BOOK_CONFIRMATION=true
ORDER_BOOK_DEPTH_LIMIT=20
ORDER_BOOK_MIN_IMBALANCE=0.55
ORDER_BOOK_MAX_SPREAD_PERCENT=0.08
ALLOW_SHORT=true

# Exit: bot close profit cepat saat laptop/server hidup.
# Jika ingin proteksi tetap ada saat laptop mati, set USE_TP_SL_ORDERS=true.
TP_PERCENT=0.20
SL_PERCENT=0.12
USE_PIP_TP_SL=false
USE_TP_SL_ORDERS=true
PROFIT_QUICK_CLOSE=true
FORCE_CLOSE_MIN_HOLD_SECONDS=0
MAX_HOLD_SECONDS=900
FORCE_CLOSE_PROFIT_USDT=0.012
FORCE_CLOSE_PROFIT_PERCENT=0
FORCE_CLOSE_PROFIT_PIPS=0
FORCE_CLOSE_LOSS=true
FORCE_CLOSE_LOSS_USDT=0.015
FORCE_CLOSE_LOSS_PERCENT=0.12
FORCE_CLOSE_LOSS_PIPS=0

USE_BREAK_EVEN_STOP=true
BREAK_EVEN_ACTIVATE_PROFIT_USDT=0.006
BREAK_EVEN_LOCK_PROFIT_USDT=0.001
USE_TRAILING_PROFIT_LOCK=true
TRAILING_PROFIT_DRAWDOWN_USDT=0.006
ALLOW_MANUAL_SIGNAL_TRADE=false
